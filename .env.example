# Sao chép thành .env.local (chạy local) hoặc khai báo trong Vercel → Settings → Environment Variables.
# Không commit file chứa giá trị thật.

# Bắt buộc ở production: khóa ký cookie phiên, tối thiểu 32 ký tự ngẫu nhiên.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAYECHO_SESSION_SECRET=

# Tài khoản Business/Guide/Admin dạng JSON (chỉ chứa hash mật khẩu). Tạo một dòng bằng:
#   node scripts/provision-user.mjs --env EMAIL ROLE [SCOPE]   (nhập mật khẩu qua stdin)
# Ví dụ: [{"id":"u_...","email":"biz@example.com","role":"business","businessId":"b1","passwordHash":"salt:hash"}]
WAYECHO_USERS=

# Danh sách origin được phép gửi request ghi (phân tách bằng dấu phẩy).
# Bắt buộc khi chạy production ngoài Vercel; trên Vercel và khi dev có thể để trống.
WAYECHO_ORIGIN=

# Chế độ lưu: để trống = file JSON khi dev, bộ nhớ tạm trên Vercel.
# memory | local-single-host (production trên một máy có ổ đĩa bền)
WAYECHO_STORAGE_MODE=
# Đường dẫn file JSON khi dùng local-single-host (mặc định data/db.json)
WAYECHO_DATA_PATH=

# Chỉ dùng khi tự host sau một reverse proxy có ký IP nguồn đăng nhập (không cần trên Vercel).
WAYECHO_PROXY_SECRET=

# Domain https chính thức cho SEO, đặt lúc build. Để trống thì noindex, không canonical, sitemap rỗng.
NEXT_PUBLIC_SITE_URL=

# Form "quan tâm hợp tác": mặc định tắt. Chỉ đặt 1 khi đã có lưu trữ bền và Admin tiếp nhận.
WAYECHO_INQUIRIES_ENABLED=0
