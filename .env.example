# Không có thông tin bí mật hoặc tài khoản mặc định.
# Dev: npm run dev có thể dùng JSON cục bộ; tài khoản do quản trị cấp qua CLI.
# Production: chọn môi trường và sao lưu trước. JSON KHÔNG hỗ trợ Vercel/multi-host.
# Chỉ đặt local-single-host khi có volume bền vững cùng host.
WAYECHO_STORAGE_MODE=
# Đường dẫn tuyệt đối trên volume bền vững; không nằm trong public/.
WAYECHO_DATA_PATH=
# Origin chính xác của website (scheme + host + port nếu có); bắt buộc production.
WAYECHO_ORIGIN=
# Domain https chính thức cho SEO, đặt lúc build. Để trống thì noindex/canonical off/sitemap rỗng.
NEXT_PUBLIC_SITE_URL=
# Mặc định tắt. Chỉ đặt 1 khi lưu trữ và Admin tiếp nhận đã được chuẩn bị.
WAYECHO_INQUIRIES_ENABLED=0

# Production login chỉ nhận source do ingress ký HMAC. Secret ngẫu nhiên >=32 ký tự,
# cấp ngoài source; proxy phải bỏ header client rồi ký IP thực + timestamp. Không ghi giá trị ở đây.
WAYECHO_PROXY_SECRET=
